    {
      "parameters": {
        "jsCode": "const d = items[0]?.json?.data || {};\nconst invoices = Array.isArray(d.invoices) ? d.invoices : [];\nconst offset = Number(d.due_offset_days ?? 0);\nconst targetDate = d.target_date || '';\n\nlet headline;\nif (offset < 0) headline = `Pripomienka: o ${Math.abs(offset)} dní je splatnosť týchto faktúr.`;\nelse if (offset > 0) headline = `Upozornenie: tieto faktúry sú ${offset} dní po splatnosti.`;\nelse headline = 'Dnes je splatnosť týchto faktúr.';\n\nconst lines = invoices.map((i) => {\n  const number = i.number ?? '—';\n  const recipient = i.recipient_name ?? '—';\n  const due = i.due_date ?? '—';\n  const status = i.status_name ?? i.status_code ?? '—';\n  return `- ${number} | ${recipient} | splatnosť: ${due} | stav: ${status}`;\n});\n\nconst subject = `Upozornenie: ${invoices.length} faktúr (${targetDate || 'termín'})`;\nconst message = [\n  'Dobrý deň,',\n  '',\n   '',\n  headline,\n  targetDate ? `Cieľový dátum: ${targetDate}` : null,\n  '',\n  '',\n  ...lines,\n  '',\n  '',\n  'Prehľad: https://invoicius.online',\n  '',\n   '',\n  'S pozdravom,',\n  'Invoicius',\n].filter(Boolean).join('\\n');\n\nreturn [{ json: { ...items[0].json, email: { to: d.user_email, subject, message, invoicesCount: invoices.length } } }];"
      },
