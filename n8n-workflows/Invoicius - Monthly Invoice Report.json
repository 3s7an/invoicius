{
  "name": "Invoicius - Monthly Invoice Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "schedule-daily",
      "name": "Daily 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://invoicius.online/api/automatizations/process",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "={{ $env.INVOICIUS_N8N_HEADER || '3stan' }}",
              "value": "={{ $env.INVOICIUS_N8N_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-process",
      "name": "Process Automatizations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "results",
        "include": "noOtherFields"
      },
      "id": "split-results",
      "name": "Split Results",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [560, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "success-true",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "type-report",
              "leftValue": "={{ $json.type }}",
              "rightValue": "invoice_report",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-report",
      "name": "Report Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.data.user_email }}",
        "subject": "=Mesačný prehľad faktúr ({{ $json.data.period.from }} – {{ $json.data.period.to }})",
        "emailType": "text",
        "message": "=Dobrý deň,\n\nzasielame mesačný prehľad faktúr za obdobie {{ $json.data.period.from }} – {{ $json.data.period.to }}:\n\n• Celkom fakturované: {{ $json.data.stats.total_invoiced }} €\n• Zaplatené: {{ $json.data.stats.paid }} €\n• Čakajúce na úhradu: {{ $json.data.stats.awaiting }} €\n• Po splatnosti: {{ $json.data.stats.overdue }} €\n\nPočet faktúr v období: {{ $json.data.invoices.length }}\n\nDetailný prehľad nájdete po prihlásení: https://invoicius.online\n\nS pozdravom,\nInvoicius",
        "options": {}
      },
      "id": "gmail-report",
      "name": "Send Monthly Report",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Daily 8:00": {
      "main": [[{ "node": "Process Automatizations", "type": "main", "index": 0 }]]
    },
    "Process Automatizations": {
      "main": [[{ "node": "Split Results", "type": "main", "index": 0 }]]
    },
    "Split Results": {
      "main": [[{ "node": "Report Only", "type": "main", "index": 0 }]]
    },
    "Report Only": {
      "main": [[{ "node": "Send Monthly Report", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Bratislava"
  },
  "id": "4Ciq75l6ahgKx6FM",
  "tags": []
}
